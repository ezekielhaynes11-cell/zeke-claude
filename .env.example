# Vapi.ai credentials
# Get these from https://dashboard.vapi.ai
VAPI_API_KEY=your_vapi_private_key_here
VAPI_PHONE_NUMBER_ID=your_vapi_phone_number_id_here

# Optional: pin a pre-created Vapi assistant instead of building it on each call
# VAPI_ASSISTANT_ID=your_assistant_id_here

# Public base URL for Vapi to deliver webhook events back to this server
# For local dev use ngrok: https://your-ngrok-id.ngrok-free.app
# For production use your deployed URL: https://yourdomain.com
WEBHOOK_BASE_URL=https://your-public-url.example.com

# Optional: shared secret Vapi will include in x-vapi-secret header for webhook auth
VAPI_WEBHOOK_SECRET=your_webhook_secret_here
